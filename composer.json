{
    "name": "symsvel-framework/tooling",
    "description": "SymSvel development tooling Symfony bundle",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^8.1",
        "symfony/console": "^8.1",
        "symfony/process": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/dotenv": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "SymSvel\\Tooling\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymSvel\\Tooling\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "qa": [
            "@php -l src/Installation/ComponentInstaller.php",
            "@php -l src/Command/SymSvelInstallCommand.php",
            "@php -l src/Update/WorkspaceUpdater.php",
            "@php -l src/Module/ModuleMaker.php",
            "@php -l src/Command/SymSvelMakeModuleCommand.php",
            "@php -l src/Module/ModuleManifest.php",
            "@php -l src/Module/ModuleRegistry.php",
            "@php -l src/Module/ModulePlanner.php",
            "@php -l src/Module/ModuleSynchronizer.php",
            "@php -l src/Command/SymSvelModulePlanCommand.php",
            "@php -l src/Module/ModuleInventoryWriter.php",
            "@php -l src/Command/SymSvelModuleSyncCommand.php",
            "@php -l src/Module/ModuleBundleResolver.php",
            "@php -l src/Module/ModuleBundleMapWriter.php",
            "@php -l src/Module/ModuleRemovalPlanner.php",
            "@php -l src/Command/SymSvelModuleRemovalPlanCommand.php",
            "@php -l src/Module/ModuleMigrationCatalog.php",
            "@php -l src/Module/ModuleMigrationDiff.php",
            "@php -l src/Module/ModuleMigrationRegistry.php",
            "@php -l src/Module/ModuleMigrationCompiler.php",
            "@php -l src/Command/SymSvelModuleMigrationsCompileCommand.php",
            "@php -l src/Module/ModuleMigrationExecutor.php",
            "@php -l tests/Module/ModuleMigrationExecutorTest.php",
            "@php -l src/Module/ModuleMigrationRecovery.php",
            "@php -l src/Command/SymSvelModuleMigrationRecoverCommand.php",
            "@php -l tests/Module/ModuleMigrationRecoveryTest.php",
            "@php -l src/Module/ModuleMigrationRemovalPlan.php",
            "@php -l src/Module/ModuleTableBackup.php",
            "@php -l tests/Module/ModuleTableBackupTest.php",
            "@php -l src/Command/SymSvelModuleRemovalMigrationsPlanCommand.php",
            "@php -l src/Command/SymSvelModuleRemovalMigrationsExecuteCommand.php",
            "@php -l tests/Module/ModuleMigrationRemovalPlanTest.php",
            "@php -l src/Module/ModuleRemovalTransaction.php",
            "@php -l tests/Module/ModuleRemovalTransactionTest.php",
            "@php -l src/Command/SymSvelModuleRemovalRecoveryStatusCommand.php",
            "@php -l src/Module/ModuleTableOwnership.php",
            "@php -l tests/Module/ModuleTableOwnershipTest.php",
            "@php -l src/Module/ModuleRemovalConfirmation.php",
            "@php -l src/Module/ModuleRemovalExecutionGate.php",
            "@php -l src/Module/ModuleMigrationRemovalExecutor.php",
            "@php -l tests/Module/ModuleRemovalConfirmationTest.php",
            "@php -l tests/Module/ModuleRemovalExecutionGateTest.php",
            "@php -l src/Module/ModuleCompiledMigrationGuard.php",
            "@php -l tests/Module/ModuleCompiledMigrationGuardTest.php",
            "@php -l tests/Module/ModuleRemovalSqliteIntegrationTest.php",
            "@php -l src/Module/ComposerModuleRegistry.php",
            "@php -l tests/Module/ComposerModuleRegistryTest.php",
            "@php -l src/Module/ComposerModulePlanner.php",
            "@php -l src/Module/ComposerModuleSynchronizer.php",
            "@php -l tests/Module/ComposerModulePlannerTest.php",
            "@php -l src/Module/ModuleWorkingDirectoryResolver.php",
            "@php -l src/Module/ModuleEntityMetadataSelector.php",
            "@php -l src/Module/ModuleDesiredSchema.php",
            "@php -l tests/Module/ModuleDesiredSchemaTest.php",
            "@php -l tests/Module/ModuleWorkingDirectoryResolverTest.php",
            "@php -l tests/Module/ModuleEntityMetadataSelectorTest.php",
            "@php -l src/Module/ModuleSchemaScope.php",
            "@php -l tests/Module/ModuleSchemaScopeTest.php",
            "@php -l src/Module/ModuleTableOwnershipGuard.php",
            "@php -l tests/Module/ModuleTableOwnershipGuardTest.php",
            "@php -l src/Module/ModuleForeignKeyGuard.php",
            "@php -l tests/Module/ModuleForeignKeyGuardTest.php",
            "@php -l src/Module/ModuleSchemaComparator.php",
            "@php -l tests/Module/ModuleSchemaComparatorTest.php",
            "@php -l src/Module/ModuleSchemaDiffGuard.php",
            "@php -l tests/Module/ModuleSchemaDiffGuardTest.php",
            "@php -l src/Module/ModuleMigrationSourceWriter.php",
            "@php -l src/Module/ModuleSchemaMigrationRenderer.php",
            "@php -l src/Module/ModuleSchemaMigrationGenerator.php",
            "@php -l src/Command/SymSvelModuleMigrateCommand.php",
            "@php -l tests/Command/SymSvelModuleMigrateCommandTest.php",
            "@php -l tests/Module/ModuleSchemaMigrationGeneratorTest.php",
            "@php -l tests/Module/ModuleSchemaMigrationRendererTest.php",
            "@php -l tests/Module/ModuleMigrationSourceWriterTest.php",
            "@php vendor/bin/phpunit",
            "@php -l src/Command/SymSvelModuleMigrationRecoveryStatusCommand.php"
