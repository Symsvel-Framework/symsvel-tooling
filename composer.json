{
    "name": "symsvel-framework/tooling",
    "description": "SymSvel development tooling Symfony bundle",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^8.1",
        "symfony/console": "^8.1",
        "symfony/process": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "SymSvel\\Tooling\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymSvel\\Tooling\\Tests\\": "tests/"
        }
    }
}
